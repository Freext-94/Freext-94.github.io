# ── Notion 内容源 ───────────────────────────────────────────
# Internal Integration Token：https://www.notion.so/my-integrations
# 本地开发复制本文件为 .env.local；GitHub Actions 里 NOTION_API_KEY 用 Repository Secret。
NOTION_API_KEY=

# 五个数据源的 ID。可以填数据源 ID，也可以直接粘贴数据库链接（会自动解析）。
# 填完用 npm run notion:setup -- --check 验证是否读得到。
NOTION_PROFILE_ID=
NOTION_PROJECTS_ID=
NOTION_SKILLS_ID=
NOTION_EXPERIENCE_ID=
NOTION_ARTICLES_ID=
