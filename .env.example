# ── Notion 内容源 ───────────────────────────────────────────
# Internal Integration Token：https://www.notion.so/my-integrations
# 本地开发复制本文件为 .env.local；GitHub Actions 里用 Repository Secret 配置同名变量。
NOTION_API_KEY=

# 四个内容库的 ID。可以填数据源 ID，也可以直接粘贴数据库链接（会自动解析）。
# 运行 npm run notion:setup -- <Notion 父页面链接> 可以一次性建好这四个库并输出下面这几行。
NOTION_PROJECTS_ID=
NOTION_SKILLS_ID=
NOTION_EXPERIENCE_ID=
NOTION_LINKS_ID=
