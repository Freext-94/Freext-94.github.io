---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Hero from '@/components/Hero.astro';
import SkillGrid from '@/components/SkillGrid.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Timeline from '@/components/Timeline.astro';
import ArticleList from '@/components/ArticleList.astro';
import Contact from '@/components/Contact.astro';
import { getPortfolio } from '@/lib/notion';

const { profile, projects, skills, experience, articles, dbNames, source } =
  await getPortfolio();

// 第一个项目若标了「精选」就占据整行，作为作品集的门面
const highlight = projects[0]?.featured ? projects[0] : undefined;
const rest = highlight ? projects.slice(1) : projects;

const education = [profile.degree, profile.school, profile.gradYear]
  .filter(Boolean)
  .join(' · ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.positioning,
  email: `mailto:${profile.email}`,
  url: new URL(Astro.url.pathname, Astro.site).href,
  sameAs: profile.github ? [profile.github] : [],
  knowsAbout: skills.map((skill) => skill.name),
};

// 转义 < ，防止字段里出现 </script> 时提前闭合标签
const jsonLdHtml = JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
---

<Base profile={profile} contentSource={source}>
  {
    /* 未配置 Notion 时只在本地开发提示，线上产物不会带这段话 */
    source === 'sample' && import.meta.env.DEV && (
      <aside class="notice">
        <div class="shell">
          <strong>当前是内置示例数据。</strong> 配好 <code>.env.local</code> 里的五个数据源
          ID 后即切换为 Notion 真实内容。
        </div>
      </aside>
    )
  }

  <Hero
    profile={profile}
    projectCount={projects.length}
    skillCount={skills.length}
    experienceCount={experience.length}
  />

  {
    profile.summary.length > 0 && (
      <Section
        id="about"
        eyebrow={dbNames.profile}
        title="我是谁"
        description={profile.positioning}
      >
        <div class="about">
          {profile.summary.map((paragraph, index) => (
            <p data-reveal style={`--i:${index}`}>{paragraph}</p>
          ))}
        </div>
      </Section>
    )
  }

  {
    skills.length > 0 && (
      <Section
        id="skills"
        eyebrow={dbNames.skills}
        title="我会做什么"
        description="按分类整理，环上的数字是我对自己的评估，不是考核结果。"
      >
        <SkillGrid skills={skills} />
      </Section>
    )
  }

  {
    projects.length > 0 && (
      <Section
        id="projects"
        eyebrow={dbNames.projects}
        title="我做过什么"
        description="展示我解决过的问题、采用的方案与实际成果；完整清单在 Notion 里维护。"
      >
        <div class="projects">
          {highlight && <ProjectCard project={highlight} wide index={0} />}
          {rest.map((project, index) => (
            <ProjectCard project={project} index={index + 1} />
          ))}
        </div>
      </Section>
    )
  }

  <Section
    id="workflow"
    eyebrow="BUILD IN PUBLIC"
    title="这个主页如何运作"
    description="它既是求职展示窗口，也是一个把内容管理、静态构建与自动部署串起来的完整项目。"
  >
    <div class="workflow">
      <article class="workflow-card card" data-reveal style="--i:0">
        <span class="workflow-step mono">01 · 内容维护</span>
        <h3>Notion</h3>
        <p>在 Profile、Projects、Skills、Experience 和 Articles 数据库维护内容，不必为日常更新修改页面代码。</p>
      </article>
      <article class="workflow-card card" data-reveal style="--i:1">
        <span class="workflow-step mono">02 · 数据读取</span>
        <h3>Notion API</h3>
        <p>构建时读取数据库，将 Notion 属性整理成页面使用的数据；状态作为标签展示，内容不因状态被隐藏。</p>
      </article>
      <article class="workflow-card card" data-reveal style="--i:2">
        <span class="workflow-step mono">03 · 静态生成</span>
        <h3>Astro</h3>
        <p>把内容预先生成为轻量静态页面，减少运行时服务依赖，兼顾加载速度与维护成本。</p>
      </article>
      <article class="workflow-card card" data-reveal style="--i:3">
        <span class="workflow-step mono">04 · 自动发布</span>
        <h3>GitHub Actions + Pages</h3>
        <p>代码推送或定时任务触发构建与部署。整条流程使用免费服务完成上线，无需自建服务器。</p>
      </article>
    </div>
    <p class="workflow-outcome" data-reveal>
      <strong>项目成果</strong>
      一个可持续更新的求职主页，以及一套从 Notion 内容管理到 GitHub Pages 发布的低成本自动化流程。
    </p>
  </Section>

  {
    experience.length > 0 && (
      <Section
        id="experience"
        eyebrow={dbNames.experience}
        title="工作历程"
        description="在哪做过什么、解决了什么问题，按时间倒着排。"
      >
        <Timeline items={experience} />

        {
          education && (
            <div class="education card" data-reveal>
              <span class="edu-label">读书经历</span>
              <p class="edu-value">{education}</p>
            </div>
          )
        }
      </Section>
    )
  }

  {
    articles.length > 0 && (
      <Section
        id="articles"
        eyebrow={dbNames.articles}
        title="我写过的东西"
        description="平时记录的一些思考和复盘。"
      >
        <ArticleList articles={articles} />
      </Section>
    )
  }

  <Section id="contact" eyebrow="CONTACT" title="怎么找到我">
    <Contact profile={profile} />
  </Section>
</Base>

<script type="application/ld+json" set:html={jsonLdHtml} />

<style>
  .notice {
    padding-block: 0.75rem;
    background: var(--brand-soft);
    border-block-end: 1px solid var(--border);
    font-size: 0.88rem;
  }

  .notice code {
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    background: var(--sunken);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .about {
    display: grid;
    gap: 1.15rem;
    max-inline-size: 46rem;
  }

  .about p {
    position: relative;
    padding-inline-start: 1.1rem;
    color: var(--text-muted);
    font-size: 1.02rem;
    white-space: pre-line;
  }

  /* border-image 只能整圈生效，单侧渐变条还是用伪元素稳妥 */
  .about p::before {
    content: '';
    position: absolute;
    inset-block: 0.25rem;
    inset-inline-start: 0;
    inline-size: 2px;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--accent-1), var(--accent-2));
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: clamp(1.25rem, 3vw, 1.9rem);
    align-items: stretch;
  }

  .workflow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .workflow-card {
    padding: clamp(1.15rem, 2.5vw, 1.5rem);
  }

  .workflow-step {
    color: var(--accent-1);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .workflow-card h3 {
    margin-block: 0.75rem 0.35rem;
    font-size: 1.08rem;
  }

  .workflow-card p,
  .workflow-outcome {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .workflow-outcome {
    margin-block: 1.25rem 0;
    padding: 1rem 1.2rem;
    border-inline-start: 3px solid var(--accent-1);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--surface);
  }

  .workflow-outcome strong {
    margin-inline-end: 0.5rem;
    color: var(--text);
  }

  .education {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-block-start: 1.75rem;
    padding: 1rem 1.25rem;
  }

  .edu-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent-1);
  }

  .edu-value {
    font-weight: 620;
    font-size: 0.95rem;
  }
</style>
