---
import Base from '@/layouts/Base.astro';
import { getPortfolio } from '@/lib/notion';

export async function getStaticPaths() {
  const { profile, projects } = await getPortfolio();
  return projects
    .filter((project) => project.slug?.trim())
    .map((project) => ({
      params: { slug: project.slug!.trim() },
      props: { profile, project },
    }));
}

const { profile, project } = Astro.props;
const title = `${project.name} · ${profile.name}的个人主页`;
const description = project.summary || `${project.name} 项目介绍。`;
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base profile={profile} title={title} description={description}>
  <article class="shell detail">
    <a class="back" href={`${home}#projects`}>← 全部项目</a>

    <header class="intro">
      <div class="meta">
        {project.category && <span class="pill pill-brand">{project.category}</span>}
        {project.status && <span class="pill">{project.status}</span>}
        {project.featured && <span class="pill">精选项目</span>}
      </div>
      <h1>{project.name}</h1>
      {project.summary && <p class="summary">{project.summary}</p>}
    </header>

    {
      project.image && (
        <div class="cover card">
          <img src={project.image} alt={`${project.name} 项目封面`} fetchpriority="high" />
        </div>
      )
    }

    {
      project.stack.length > 0 && (
        <section class="content-block" aria-labelledby="stack-title">
          <h2 id="stack-title">技术与工具</h2>
          <ul class="pills">
            {project.stack.map((item) => <li class="pill">{item}</li>)}
          </ul>
        </section>
      )
    }

    {
      project.details?.map((block) => {
        if (block.type === 'heading') {
          // 页面标题已占用 h1，正文里的 Notion 标题整体下移一级，避免出现两个 h1。
          // 字号由 .level-N 这个 Notion 层级决定，跟标签无关，所以视觉不变。
          const Tag = `h${Math.min(block.level + 1, 4)}` as 'h2' | 'h3' | 'h4';
          return <Tag class:list={['detail-heading', `level-${block.level}`]} set:html={block.html} />;
        }
        if (block.type === 'paragraph') return <p class="detail-paragraph" set:html={block.html} />;
        if (block.type === 'quote') return <blockquote class="quote" set:html={block.html} />;
        if (block.type === 'list') {
          const List = block.ordered ? 'ol' : 'ul';
          return <List class="detail-list">{block.items.map((item) => <li set:html={item} />)}</List>;
        }
        if (block.type === 'image') return (
          <figure class="detail-image card">
            <img src={block.url} alt={block.caption || `${project.name} 项目图片`} loading="lazy" />
            {block.caption && <figcaption set:html={block.caption} />}
          </figure>
        );
        return null;
      })
    }

    {
      (project.demo || project.repo) && (
        <nav class="actions" aria-label="项目链接">
          {project.demo && <a class="btn btn-primary" href={project.demo} target="_blank" rel="noopener noreferrer">查看演示</a>}
          {project.repo && <a class="btn btn-ghost" href={project.repo} target="_blank" rel="noopener noreferrer">查看源码</a>}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .detail {
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  .back {
    display: inline-block;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .intro {
    max-inline-size: 54rem;
  }

  .meta,
  .actions,
  .pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .intro h1 {
    margin-block: 1rem 0.75rem;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .summary {
    max-inline-size: 46rem;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
  }

  .cover {
    overflow: hidden;
    margin-block: clamp(2rem, 5vw, 3.5rem);
    background: var(--surface);
  }

  .cover img {
    inline-size: 100%;
    max-block-size: 38rem;
    object-fit: cover;
  }

  .content-block {
    margin-block: 2rem;
  }

  .content-block h2 {
    margin-block-end: 0.8rem;
    font-size: 1rem;
  }

  .detail-heading {
    max-inline-size: 48rem;
    margin-block: 2rem 0.65rem;
  }

  .detail-heading.level-1 { font-size: 1.6rem; }
  .detail-heading.level-2 { font-size: 1.3rem; }
  .detail-heading.level-3 { font-size: 1.08rem; }

  .detail-paragraph,
  .detail-list,
  .quote {
    max-inline-size: 48rem;
    color: var(--text-muted);
    line-height: 1.85;
  }

  /*
   * 正文里的 strong / a / code 是 set:html 注入的，不带 scoped 属性，
   * 必须用 :global 才选得到；限定在 .detail 之下，避免样式外泄到全站。
   */
  .detail :global(strong) {
    color: var(--text);
    font-weight: 680;
  }

  .detail :global(em) {
    font-style: italic;
  }

  .detail :global(s) {
    opacity: 0.6;
  }

  .detail :global(code) {
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--sunken);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .detail :global(a) {
    color: var(--accent-1);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent-1) 45%, transparent);
    text-underline-offset: 0.18em;
    transition: color 0.2s var(--ease);
  }

  .detail :global(a:hover) {
    color: var(--accent-2);
  }

  /* Notion 文字颜色 → 主题变量，保持跟页面同一套色板 */
  .detail :global([data-color='purple']) { color: var(--accent-1); }
  .detail :global([data-color='pink']) { color: var(--accent-2); }
  .detail :global([data-color='orange']) { color: var(--accent-3); }
  .detail :global([data-color='blue']) { color: var(--accent-4); }
  .detail :global([data-color='green']) { color: #16a34a; }
  .detail :global([data-color='yellow']) { color: #b45309; }
  .detail :global([data-color='red']) { color: #dc2626; }
  .detail :global([data-color='brown']),
  .detail :global([data-color='gray']) { color: var(--text-muted); }

  .detail-list {
    display: grid;
    gap: 0.4rem;
    padding-inline-start: 1.5rem;
  }

  .quote {
    margin-inline: 0;
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--accent-1);
    background: var(--surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .detail-image {
    max-inline-size: 54rem;
    margin-block: 1.5rem;
    overflow: hidden;
  }

  .detail-image img {
    inline-size: 100%;
    max-block-size: 38rem;
    object-fit: contain;
  }

  .detail-image figcaption {
    padding: 0.65rem 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .pills {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
