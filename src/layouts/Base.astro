---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import type { ProfileInfo } from '@/lib/types';
import '../styles/global.css';

interface Props {
  profile: ProfileInfo;
  contentSource?: 'notion' | 'sample';
  title?: string;
  description?: string;
}

const {
  profile,
  contentSource = 'notion',
  title = profile.positioning
    ? `${profile.name} · ${profile.positioning}`
    : profile.name,
  description = profile.summary[0] ?? '个人主页与作品集。',
} = Astro.props;

// trailingSlash 为 ignore 时 BASE_URL 不带尾斜杠，直接拼接会少一个 /
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#f6f5fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09080f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={profile.name} />
    {profile.avatar && <meta property="og:image" content={profile.avatar} />}
    <meta name="twitter:card" content={profile.avatar ? 'summary_large_image' : 'summary'} />

    <!-- 首帧前定主题，避免刷新时闪一下亮色 -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Nav profile={profile} />
    <main id="main">
      <slot />
    </main>
    <Footer profile={profile} source={contentSource} />
  </body>
</html>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      // 底部留白，避免元素刚露头就触发，看起来像突然弹出来
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    targets.forEach((el) => observer.observe(el));
  }

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
    toggle.setAttribute('aria-label', next === 'dark' ? '切换到亮色主题' : '切换到暗色主题');
  });
</script>

<style is:global>
  .skip-link {
    position: absolute;
    inset-block-start: -4rem;
    inset-inline-start: 1rem;
    z-index: 100;
    padding: 0.6rem 1.1rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--surface-solid);
    box-shadow: var(--shadow-card);
    font-weight: 600;
    text-decoration: none;
    transition: inset-block-start 0.2s var(--ease);
  }

  .skip-link:focus-visible {
    inset-block-start: 0;
  }
</style>
