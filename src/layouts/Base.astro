---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import type { ProfileInfo } from '@/lib/types';
import '@fontsource-variable/noto-sans-sc';
import '../styles/global.css';

interface Props {
  profile: ProfileInfo;
  contentSource?: 'notion' | 'sample';
  title?: string;
  description?: string;
  /** 分享卡片图，传站内绝对路径；默认首页那张 1200×630 */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  profile,
  contentSource = 'notion',
  title,
  description = profile.summary[0] ?? '个人主页与作品集。',
  ogImage = '/og.png',
  ogImageAlt,
} = Astro.props;

/** 站名跟着 Notion 的「姓名」走，改名不用动代码 */
const siteName = `${profile.name}的个人主页`;
const heading = title ?? `${siteName} · ${profile.positioning}`;

// trailingSlash 为 ignore 时 BASE_URL 不带尾斜杠，直接拼接会少一个 /
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// 详情页产物是目录形式，canonical 统一补尾斜杠，和 sitemap 保持一致
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site);
// 分享卡片必须用绝对地址，相对路径在微信/飞书里抓不到
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{heading}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#f6f5fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09080f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={heading} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? heading} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- 首帧前定主题，避免刷新时闪一下亮色 -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>

    <!-- 访问统计：不蒜子，零注册、无 Cookie；脚本失败时页脚计数自动隐藏 -->
    <script is:inline defer src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Nav profile={profile} />
    <main id="main">
      <slot />
    </main>
    <Footer profile={profile} source={contentSource} />
  </body>
</html>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      // 底部留白，避免元素刚露头就触发，看起来像突然弹出来
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    targets.forEach((el) => observer.observe(el));
  }

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
    toggle.setAttribute('aria-label', next === 'dark' ? '切换到亮色主题' : '切换到暗色主题');
  });
</script>

<style is:global>
  .skip-link {
    position: absolute;
    inset-block-start: -4rem;
    inset-inline-start: 1rem;
    z-index: 100;
    padding: 0.6rem 1.1rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--surface-solid);
    box-shadow: var(--shadow-card);
    font-weight: 600;
    text-decoration: none;
    transition: inset-block-start 0.2s var(--ease);
  }

  .skip-link:focus-visible {
    inset-block-start: 0;
  }
</style>
