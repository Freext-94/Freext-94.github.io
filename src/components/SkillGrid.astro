---
import type { Skill } from '@/lib/types';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

// Object.groupBy 需要 ES2024 lib，这里保持低依赖
const groups = skills.reduce<Map<string, Skill[]>>((acc, skill) => {
  const list = acc.get(skill.category);
  if (list) list.push(skill);
  else acc.set(skill.category, [skill]);
  return acc;
}, new Map());
---

<div class="wrap">
  {
    [...groups].map(([category, items], groupIndex) => (
      <div class="card group" data-reveal style={`--i:${groupIndex}`}>
        <h3 class="group-title">
          <span class="dot" aria-hidden="true"></span>
          {category}
          <span class="count mono">{items.length}</span>
        </h3>

        <ul class="list">
          {items.map((skill, index) => (
            <li class="row" data-reveal style={`--i:${index}`}>
              <div class="head">
                <span class="name">{skill.name}</span>
                {skill.proficiency && <span class="pill pill-brand">{skill.proficiency}</span>}
                {skill.status && <span class="pill">{skill.status}</span>}
              </div>
              {skill.note && <p class="note">{skill.note}</p>}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: clamp(1.25rem, 3vw, 1.9rem);
    align-items: start;
  }

  .group {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 1.15rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }

  .group-title .dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 3px;
    background: var(--brand);
    flex-shrink: 0;
  }

  .count {
    margin-inline-start: auto;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    gap: 0.2rem;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .name {
    font-weight: 640;
    font-size: 0.98rem;
  }

  .note {
    font-size: 0.87rem;
    color: var(--text-muted);
  }
</style>
