---
import type { Skill } from '@/lib/types';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

// 按分类分组，保留数据层给出的顺序（分类按各自最高熟练度排列）
const groups = skills.reduce<Map<string, Skill[]>>((acc, skill) => {
  const list = acc.get(skill.category);
  if (list) list.push(skill);
  else acc.set(skill.category, [skill]);
  return acc;
}, new Map());

const avg = (items: Skill[]) =>
  Math.round(items.reduce((sum, s) => sum + s.level, 0) / items.length);
---

<div class="wrap">
  {
    [...groups].map(([category, items], groupIndex) => {
      const position = items.find((s) => s.position)?.position;
      return (
        <div class="card group" data-reveal style={`--i:${groupIndex}`}>
          <header class="head">
            <h3 class="title">
              <span class="dot" aria-hidden="true"></span>
              {category}
            </h3>
            <span class="score mono">{avg(items)}</span>
          </header>

          {position && <p class="position">{position}</p>}

          <ul class="list">
            {items.map((skill, index) => (
              <li class="row" data-reveal style={`--i:${index}`}>
                <div class="line">
                  <span class="name">{skill.name}</span>
                  <span class="value mono">{skill.level}</span>
                </div>
                <span class="track" role="presentation">
                  <span class="fill" style={`--level:${skill.level}%`}></span>
                  <span class="sr-only">熟练度 {skill.level}%</span>
                </span>
                {skill.note && <p class="note">{skill.note}</p>}
                {skill.tags.length > 0 && <p class="tags">{skill.tags.join(' · ')}</p>}
              </li>
            ))}
          </ul>
        </div>
      );
    })
  }
</div>

<style>
  .wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr));
    gap: clamp(1.25rem, 3vw, 1.9rem);
    align-items: start;
  }

  .group {
    padding: clamp(1.25rem, 2.5vw, 1.7rem);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .title .dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 3px;
    background: var(--brand);
    flex-shrink: 0;
  }

  /* 组均值：一眼看出这一类整体在什么水位 */
  .score {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .score::before {
    content: '均值 ';
    font-family: var(--font-sans);
    font-size: 0.72rem;
  }

  /* 「技能定位」在同一分类下取值一致，用作分组的一句话说明 */
  .position {
    margin-block: 0.35rem 1.2rem;
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  .list {
    display: grid;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    gap: 0.35rem;
  }

  .line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .name {
    font-weight: 620;
    font-size: 0.96rem;
  }

  .value {
    font-size: 0.78rem;
    color: var(--accent-1);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .track {
    position: relative;
    display: block;
    block-size: 0.42rem;
    border-radius: 999px;
    background: var(--sunken);
    overflow: hidden;
  }

  .fill {
    display: block;
    block-size: 100%;
    inline-size: 0;
    border-radius: inherit;
    background-image: var(--brand);
    background-size: 200% 100%;
    transition: inline-size 1.05s var(--ease) 0.15s;
  }

  /* 进场那一刻才把宽度撑起来，比页面一加载就静止的进度条有精神 */
  .row.is-visible .fill {
    inline-size: var(--level, 0%);
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .note {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* 标签用中点串成一行，避免 17 条技能堆出上百个胶囊 */
  .tags {
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.8;
  }
</style>
