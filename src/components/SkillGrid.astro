---
import type { Skill } from '@/lib/types';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

// Object.groupBy 需要 ES2024 lib，这里保持低依赖
const groups = skills.reduce<Map<string, Skill[]>>((acc, skill) => {
  const list = acc.get(skill.category);
  if (list) list.push(skill);
  else acc.set(skill.category, [skill]);
  return acc;
}, new Map());
---

<div class="wrap">
  {
    [...groups].map(([category, items], groupIndex) => (
      <div class="group" data-reveal style={`--i:${groupIndex}`}>
        <h3 class="group-title">
          <span class="dot" aria-hidden="true"></span>
          {category}
        </h3>

        <ul class="list">
          {items.map((skill, index) => (
            <li class="row" data-reveal style={`--i:${index}`}>
              <span class="icon" aria-hidden="true">{skill.icon ?? '·'}</span>
              <span class="name" title={skill.note}>
                {skill.name}
              </span>
              <span class="track">
                <span class="fill" style={`--level:${skill.level}%`}></span>
              </span>
              <span class="value mono">{skill.level}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  .group {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 1.1rem;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 700;
  }

  .group-title .dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 3px;
    background: var(--brand);
  }

  .list {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr) 4.5rem 2rem;
    align-items: center;
    gap: 0.7rem;
  }

  .icon {
    font-size: 1rem;
    text-align: center;
  }

  .name {
    font-weight: 600;
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track {
    block-size: 0.42rem;
    border-radius: 999px;
    background: var(--sunken);
    overflow: hidden;
  }

  .fill {
    display: block;
    block-size: 100%;
    inline-size: 0;
    border-radius: inherit;
    background-image: var(--brand);
    background-size: 200% 100%;
    transition: inline-size 1.05s var(--ease) 0.15s;
  }

  /* 进场那一刻才把宽度撑起来，比页面一加载就静止的进度条有精神 */
  .row.is-visible .fill {
    inline-size: var(--level, 0%);
  }

  .value {
    color: var(--text-muted);
    font-size: 0.8rem;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .row:hover .fill {
    background-position: 100% 0;
    transition:
      inline-size 1.05s var(--ease) 0.15s,
      background-position 0.6s var(--ease);
  }

  @media (width <= 30rem) {
    .row {
      grid-template-columns: 1.2rem minmax(0, 1fr) 3rem;
    }

    .value {
      display: none;
    }
  }
</style>
