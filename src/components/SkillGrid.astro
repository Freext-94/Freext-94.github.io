---
import type { Skill } from '@/lib/types';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

// 按分类分组，保留数据层给出的顺序（分类按各自最高熟练度排列）
const groups = skills.reduce<Map<string, Skill[]>>((acc, skill) => {
  const list = acc.get(skill.category);
  if (list) list.push(skill);
  else acc.set(skill.category, [skill]);
  return acc;
}, new Map());

const avg = (items: Skill[]) =>
  Math.round(items.reduce((sum, s) => sum + s.level, 0) / items.length);
---

<div class="wrap">
  {
    [...groups].map(([category, items], groupIndex) => {
      const position = items.find((s) => s.position)?.position;
      return (
        <div class="card group" data-reveal style={`--i:${groupIndex}`}>
          <header class="head">
            <h3 class="title">
              <span class="dot" aria-hidden="true"></span>
              {category}
            </h3>
            <span class="score mono">均值 {avg(items)}</span>
          </header>

          {position && <p class="position">{position}</p>}

          <ul class="list">
            {items.map((skill, index) => (
              <li class="row" data-reveal style={`--i:${index}`}>
                <div class="gauge" style={`--target:${skill.level}`} aria-hidden="true">
                  <span class="num mono">{skill.level}</span>
                </div>

                <div class="text">
                  <p class="name">{skill.name}</p>
                  {skill.note && <p class="note">{skill.note}</p>}
                  {skill.tags.length > 0 && (
                    <p class="tags">{skill.tags.join(' · ')}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      );
    })
  }
</div>

<style>
  .wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(23rem, 1fr));
    gap: clamp(1.25rem, 3vw, 1.9rem);
    align-items: start;
  }

  .group {
    padding: clamp(1.25rem, 2.5vw, 1.7rem);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .title .dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 3px;
    background: var(--brand);
    flex-shrink: 0;
  }

  .score {
    font-size: 0.76rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 「技能定位」在同一分类下取值一致，用作分组的一句话说明 */
  .position {
    margin-block: 0.35rem 1.25rem;
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  .list {
    display: grid;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: var(--gauge-size) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  /* ── 半环仪表 ───────────────────────────────────────── */

  .gauge {
    --gauge-size: 5rem;
    --gauge-stroke: 0.45rem;
    --level: 0;
    position: relative;
    inline-size: var(--gauge-size);
    /* 半圆 + 环带在直径线上的一点余量，避免描边被裁掉 */
    block-size: calc(var(--gauge-size) / 2 + var(--gauge-stroke) / 2);
    transition: --level 1.1s var(--ease) 0.12s;
  }

  .row.is-visible .gauge {
    --level: var(--target, 0);
  }

  /*
   * from 270deg 让 0 角落在 9 点钟方向，顺时针扫 180° 正好走完上半圆，
   * 所以 level 每 1 分对应 1.8 度。三段色让填充弧本身走一遍品牌渐变。
   */
  .gauge::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--gauge-size);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(
      from 270deg,
      var(--accent-1) 0deg,
      var(--accent-2) calc(var(--level) * 0.9deg),
      var(--accent-3) calc(var(--level) * 1.8deg),
      color-mix(in oklab, var(--text) 12%, transparent) calc(var(--level) * 1.8deg + 0.001deg)
    );
    -webkit-mask: radial-gradient(
      closest-side,
      transparent calc(100% - var(--gauge-stroke)),
      #000 calc(100% - var(--gauge-stroke))
    );
    mask: radial-gradient(
      closest-side,
      transparent calc(100% - var(--gauge-stroke)),
      #000 calc(100% - var(--gauge-stroke))
    );
    clip-path: inset(0 0 50% 0);
  }

  /* 数字压在直径线上，正好落在弧的开口处 */
  .num {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    text-align: center;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .text {
    display: grid;
    gap: 0.3rem;
    padding-block-start: 0.1rem;
  }

  .name {
    font-weight: 640;
    font-size: 0.98rem;
  }

  .note {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* 标签用中点串成一行，避免 17 条技能堆出上百个胶囊 */
  .tags {
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.8;
  }

  @media (width <= 30rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>
