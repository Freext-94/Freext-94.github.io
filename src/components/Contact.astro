---
import SocialIcon from '@/components/SocialIcon.astro';
import type { ProfileInfo } from '@/lib/types';

interface Props {
  profile: ProfileInfo;
}

const { profile } = Astro.props;

interface ContactItem {
  label: string;
  caption: string;
  icon: string;
  url: string;
  isEmail: boolean;
}

const items: ContactItem[] = [];
if (profile.email) {
  items.push({
    label: profile.email,
    caption: '邮箱',
    icon: 'mail',
    url: `mailto:${profile.email}`,
    isEmail: true,
  });
}
if (profile.github) {
  items.push({
    label: profile.github.replace(/^https?:\/\/(www\.)?/, ''),
    caption: 'GitHub',
    icon: 'github',
    url: profile.github,
    isEmail: false,
  });
}
---

<div class="card panel">
  <div class="glow" aria-hidden="true"></div>

  <div class="content">
    <h3 class="big">
      很高兴认识你，<span class="brand-text">随时联系</span>
    </h3>
    <p class="lede">
      关于 AI 应用落地、企业数字化运营，岗位沟通，都可以联系我
      {profile.city ? <>（目前在{profile.city}）</> : ''}。
    </p>

    {
      items.length > 0 && (
        <ul class="links">
          {items.map((item, index) => (
            <li data-reveal style={`--i:${index}`}>
              <a
                class="link"
                href={item.url}
                target={item.isEmail ? undefined : '_blank'}
                rel={item.isEmail ? undefined : 'noopener noreferrer'}
              >
                <span class="badge">
                  <SocialIcon icon={item.icon} label={item.caption} />
                </span>
                <span class="text">
                  <span class="caption">{item.caption}</span>
                  <span class="label">{item.label}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      profile.socials.length > 0 && (
        <section class="socials" aria-label="社交媒体">
          <p class="socials-hint muted">鼠标悬停或点击即可查看二维码</p>
          <ul class="social-list">
            {profile.socials.map((s, index) => (
              <li data-reveal style={`--i:${index}`}>
                <button
                  type="button"
                  class="social"
                  data-qr
                  aria-expanded="false"
                  aria-label={`查看${s.label}二维码`}
                >
                  <span class="face front">
                    <span class="badge">
                      <SocialIcon icon={s.icon} label={s.label} />
                    </span>
                    <span class="text">
                      <span class="caption">{s.label}</span>
                      <span class="label">扫码添加</span>
                    </span>
                  </span>
                  <span class="face back">
                    {/*
                      图床链接失效时（返回 HTML 而非图片）标记 data-broken，
                      让正面保持可见——否则悬浮会翻出一块空白。
                    */}
                    <img
                      src={s.qr}
                      alt={`${s.label}二维码`}
                      loading="lazy"
                      decoding="async"
                      width="220"
                      height="220"
                      onerror="this.closest('.social').dataset.broken = 'true'"
                    />
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</div>

<script>
  // 触屏没有 hover，用 aria-expanded 把同一套正反面切换交给点击
  document.querySelectorAll<HTMLButtonElement>('.social[data-qr]').forEach((tile) => {
    tile.addEventListener('click', () => {
      const open = tile.getAttribute('aria-expanded') === 'true';
      document
        .querySelectorAll<HTMLButtonElement>('.social[data-qr]')
        .forEach((other) => other.setAttribute('aria-expanded', 'false'));
      tile.setAttribute('aria-expanded', String(!open));
    });
  });

  // 点到卡片外面时收起，避免二维码一直占着
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest?.('.social[data-qr]')) {
      document
        .querySelectorAll<HTMLButtonElement>('.social[data-qr][aria-expanded="true"]')
        .forEach((tile) => tile.setAttribute('aria-expanded', 'false'));
    }
  });
</script>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 4.5vw, 3.25rem);
  }

  /* 右上角一团缓慢呼吸的品牌色，给整块内容一点纵深 */
  .glow {
    position: absolute;
    inset-block-start: -12rem;
    inset-inline-end: -8rem;
    inline-size: 26rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--bg-tint-2), transparent 68%);
    pointer-events: none;
    animation: float 12s var(--ease) infinite alternate;
  }

  @keyframes float {
    to {
      transform: translate3d(-2rem, 1.5rem, 0) scale(1.12);
    }
  }

  .content {
    position: relative;
    display: grid;
    gap: 1rem;
    max-inline-size: 46rem;
  }

  .big {
    font-size: clamp(1.7rem, 4.2vw, 2.8rem);
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.02rem;
    max-inline-size: 36rem;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    text-decoration: none;
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .link:hover {
    border-color: var(--border-strong);
    background: var(--sunken);
    transform: translateY(-2px);
  }

  .badge {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    border-radius: 0.65rem;
    border: 1px solid var(--border);
    background: var(--surface-solid);
    color: var(--accent-1);
    flex-shrink: 0;
    transition: transform 0.35s var(--ease), color 0.3s;
  }

  .link:hover .badge {
    transform: rotate(-6deg) scale(1.06);
    color: var(--accent-2);
  }

  .text {
    display: grid;
    min-inline-size: 0;
  }

  .caption {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .label {
    font-weight: 620;
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── 社交媒体 ───────────────────────────────────────── */

  .socials {
    margin-block-start: 1.75rem;
  }

  .socials-hint {
    font-size: 0.76rem;
    margin-block-end: 0.7rem;
  }

  .social-list {
    display: grid;
    /* 二维码本身只有 9.5rem，卡片拉满整行会留下大片空白 */
    grid-template-columns: repeat(auto-fill, minmax(11rem, 15rem));
    justify-content: start;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * 正反面叠在同一个盒子里，二维码始终在卡片自己的边界内出现——
   * .panel 有 overflow: hidden，往外抛的浮层会被裁掉。
   */
  .social {
    position: relative;
    display: block;
    inline-size: 100%;
    min-block-size: 11rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-solid);
    font: inherit;
    color: inherit;
    text-align: start;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .social:hover,
  .social:focus-visible,
  .social[aria-expanded='true'] {
    border-color: var(--accent-1);
    box-shadow: var(--shadow-card);
  }

  /* 二维码取不到时不再翻转，正面一直显示，避免翻出一块空白 */
  .social[data-broken] {
    cursor: default;
  }

  .social[data-broken] .back {
    visibility: hidden;
  }

  .social[data-broken]:hover .front,
  .social[data-broken]:focus-visible .front,
  .social[data-broken][aria-expanded='true'] .front {
    opacity: 1;
    transform: none;
  }

  .face {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    position: absolute;
    inset: 0;
    padding: 1rem;
    transition: opacity 0.3s var(--ease), transform 0.35s var(--ease);
  }

  .back {
    opacity: 0;
    transform: scale(0.94);
    display: grid;
    place-items: center;
    background: var(--sunken);
  }

  .back img {
    inline-size: min(100%, 9.5rem);
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
  }

  .social:hover .front,
  .social:focus-visible .front,
  .social[aria-expanded='true'] .front {
    opacity: 0;
    transform: scale(0.96);
  }

  .social:hover .back,
  .social:focus-visible .back,
  .social[aria-expanded='true'] .back {
    opacity: 1;
    transform: none;
  }

  .social .badge {
    flex-shrink: 0;
  }
</style>
