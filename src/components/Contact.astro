---
import SocialIcon from '@/components/SocialIcon.astro';
import type { ProfileInfo } from '@/lib/types';

interface Props {
  profile: ProfileInfo;
}

const { profile } = Astro.props;

interface ContactItem {
  label: string;
  caption: string;
  icon: string;
  url: string;
  isEmail: boolean;
}

const items: ContactItem[] = [];
if (profile.email) {
  items.push({
    label: profile.email,
    caption: '邮箱',
    icon: 'mail',
    url: `mailto:${profile.email}`,
    isEmail: true,
  });
}
if (profile.github) {
  items.push({
    label: profile.github.replace(/^https?:\/\/(www\.)?/, ''),
    caption: 'GitHub',
    icon: 'github',
    url: profile.github,
    isEmail: false,
  });
}
---

<div class="card panel">
  <div class="glow" aria-hidden="true"></div>

  <div class="content">
    <h3 class="big">
      很高兴认识你，<span class="brand-text">随时联系</span>
    </h3>
    <p class="lede">
      关于 AI 应用落地、企业数字化运营，或者想索取一份完整简历，都可以直接写邮件给我
      {profile.city ? <>（目前在{profile.city}）</> : ''}。
    </p>

    {
      items.length > 0 && (
        <ul class="links">
          {items.map((item, index) => (
            <li data-reveal style={`--i:${index}`}>
              <a
                class="link"
                href={item.url}
                target={item.isEmail ? undefined : '_blank'}
                rel={item.isEmail ? undefined : 'noopener noreferrer'}
              >
                <span class="badge">
                  <SocialIcon icon={item.icon} label={item.caption} />
                </span>
                <span class="text">
                  <span class="caption">{item.caption}</span>
                  <span class="label">{item.label}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 4.5vw, 3.25rem);
  }

  /* 右上角一团缓慢呼吸的品牌色，给整块内容一点纵深 */
  .glow {
    position: absolute;
    inset-block-start: -12rem;
    inset-inline-end: -8rem;
    inline-size: 26rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--bg-tint-2), transparent 68%);
    pointer-events: none;
    animation: float 12s var(--ease) infinite alternate;
  }

  @keyframes float {
    to {
      transform: translate3d(-2rem, 1.5rem, 0) scale(1.12);
    }
  }

  .content {
    position: relative;
    display: grid;
    gap: 1rem;
    max-inline-size: 46rem;
  }

  .big {
    font-size: clamp(1.7rem, 4.2vw, 2.8rem);
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.02rem;
    max-inline-size: 36rem;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    text-decoration: none;
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .link:hover {
    border-color: var(--border-strong);
    background: var(--sunken);
    transform: translateY(-2px);
  }

  .badge {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    border-radius: 0.65rem;
    border: 1px solid var(--border);
    background: var(--surface-solid);
    color: var(--accent-1);
    flex-shrink: 0;
    transition: transform 0.35s var(--ease), color 0.3s;
  }

  .link:hover .badge {
    transform: rotate(-6deg) scale(1.06);
    color: var(--accent-2);
  }

  .text {
    display: grid;
    min-inline-size: 0;
  }

  .caption {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .label {
    font-weight: 620;
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
