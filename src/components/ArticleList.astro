---
import type { Article } from '@/lib/types';
import { articlePath } from '@/lib/routes';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

const monthYear = (iso?: string) => {
  if (!iso) return undefined;
  const [, year, month] = /^(\d{4})-(\d{2})/.exec(iso) ?? [];
  return year ? `${year}.${month}` : undefined;
};
---

<ol class="list">
  {
    articles.map((article, index) => {
      const published = monthYear(article.publishedOn);
      const href = articlePath(article.slug);
      const Cover = href ? 'a' : 'div';
      return (
        <li class="card lift row" data-reveal style={`--i:${index}`}>
          <Cover class="cover" href={href} aria-label={href ? article.title : undefined}>
            <span class="initial" aria-hidden="true">
              {article.title.trim().slice(0, 1) || '文'}
            </span>
            {article.image && (
              <img
                src={article.image}
                alt={`${article.title} 封面`}
                loading="lazy"
                decoding="async"
                onerror="this.remove()"
              />
            )}
          </Cover>

          <div class="meta">
            {article.category && <span class="pill pill-brand">{article.category}</span>}
            {published && <span class="when mono">{published}</span>}
          </div>

          <h3 class="title">
            {href ? <a href={href}>{article.title}</a> : article.title}
          </h3>

          {article.summary && <p class="summary">{article.summary}</p>}

          {article.tags.length > 0 && (
            <ul class="pills">
              {article.tags.map((tag) => (
                <li class="pill">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: clamp(1.1rem, 2.5vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }

  .row {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: clamp(1.15rem, 2.5vw, 1.6rem);
  }

  /* 封面用首字渐变兜底：图片加载失败时直接移除 img，底下这层就露出来 */
  .cover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin-block-end: 0.4rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--brand-soft);
    text-decoration: none;
  }

  .cover img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .initial {
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent-1);
    opacity: 0.5;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .when {
    font-size: 0.76rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.012em;
  }

  .title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .title a:hover {
    color: var(--accent-1);
  }

  .summary {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>
