---
import type { Article } from '@/lib/types';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

const monthYear = (iso?: string) => {
  if (!iso) return undefined;
  const [, year, month] = /^(\d{4})-(\d{2})/.exec(iso) ?? [];
  return year ? `${year}.${month}` : undefined;
};
---

<ol class="list">
  {
    articles.map((article, index) => {
      const published = monthYear(article.publishedAt);
      return (
        <li class="card lift row" data-reveal style={`--i:${index}`}>
          <div class="meta">
            {article.category && <span class="pill pill-brand">{article.category}</span>}
            {published && <span class="when mono">{published}</span>}
            {article.status && <span class="pill">{article.status}</span>}
          </div>

          <h3 class="title">{article.title}</h3>

          {article.summary && <p class="summary">{article.summary}</p>}

          {article.tags.length > 0 && (
            <ul class="pills">
              {article.tags.map((tag) => (
                <li class="pill">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: clamp(1.1rem, 2.5vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }

  .row {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: clamp(1.15rem, 2.5vw, 1.6rem);
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .when {
    font-size: 0.76rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.012em;
  }

  .summary {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>
