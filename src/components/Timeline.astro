---
import type { ExperienceItem } from '@/lib/types';

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item, index) => (
      <li class="item" data-reveal style={`--i:${index}`}>
        <span class="node" aria-hidden="true">
          {item.current && <span class="live" />}
        </span>

        <div class="card body">
          <div class="head">
            <h3>{item.company}</h3>
            <span class="period mono">{item.period}</span>
          </div>

          {item.role && <p class="role">{item.role}</p>}

          {item.duties.length > 0 && (
            <ul class="duties">
              {item.duties.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          )}

          {item.achievements.length > 0 && (
            <div class="outcomes">
              <p class="outcomes-label">主要成果</p>
              <ul>
                {item.achievements.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --rail: 1.25rem;
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 贯穿的渐变竖线，两端淡出 */
  .timeline::before {
    content: '';
    position: absolute;
    inset-block: 0.5rem;
    inset-inline-start: calc(var(--rail) / 2);
    inline-size: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklab, var(--accent-1) 45%, transparent) 10%,
      color-mix(in oklab, var(--accent-2) 45%, transparent) 70%,
      transparent
    );
  }

  .item {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
    align-items: start;
  }

  .node {
    position: relative;
    block-size: 2.4rem;
    justify-self: center;
  }

  .node::before {
    content: '';
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 0.72rem;
    block-size: 0.72rem;
    border-radius: 50%;
    background: var(--surface-solid);
    border: 2px solid var(--accent-1);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-1) 14%, transparent);
    transition: transform 0.35s var(--ease), border-color 0.35s;
  }

  .item:hover .node::before {
    transform: scale(1.25);
    border-color: var(--accent-2);
  }

  .live {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 0.72rem;
    block-size: 0.72rem;
    border-radius: 50%;
    background: var(--brand);
    animation: breathe 2.6s var(--ease) infinite;
  }

  @keyframes breathe {
    50% {
      transform: scale(1.35);
      opacity: 0.75;
    }
  }

  .body {
    padding: clamp(1rem, 2.2vw, 1.4rem);
    display: grid;
    gap: 0.55rem;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .period {
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .role {
    font-size: 0.88rem;
    font-weight: 640;
    color: var(--accent-2);
  }

  .duties {
    display: grid;
    gap: 0.4rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }

  .duties li {
    position: relative;
    padding-inline-start: 1rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .duties li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 0.34rem;
    block-size: 0.34rem;
    border-radius: 2px;
    background: var(--brand);
  }

  /* 成果和职责视觉上分块，避免两堆要点混在一起 */
  .outcomes {
    margin-block-start: 0.5rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--brand-soft);
    border: 1px solid color-mix(in oklab, var(--accent-1) 22%, transparent);
  }

  .outcomes-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-1);
    margin-block-end: 0.45rem;
  }

  .outcomes ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outcomes li {
    position: relative;
    padding-inline-start: 1rem;
    font-size: 0.9rem;
  }

  .outcomes li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    inline-size: 0.55rem;
    block-size: 0.28rem;
    border-inline-start: 2px solid var(--accent-1);
    border-block-end: 2px solid var(--accent-1);
    transform: rotate(-45deg);
  }
</style>
