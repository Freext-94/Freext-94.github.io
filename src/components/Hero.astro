---
import type { ProfileInfo } from '@/lib/types';

interface Props {
  profile: ProfileInfo;
  projectCount: number;
  skillCount: number;
  experienceCount: number;
}

const { profile, projectCount, skillCount, experienceCount } = Astro.props;

const stats = [
  { value: projectCount, label: '个项目' },
  { value: skillCount, label: '项技能' },
  { value: experienceCount, label: '段经历' },
];
---

<section class="hero" id="top">
  <div class="shell grid">
    <div class="copy">
      <p class="place" data-reveal style="--i:0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
          <circle cx="12" cy="10" r="2.6" />
        </svg>
        {profile.city || '未填写所在城市'}
      </p>

      <h1 data-reveal style="--i:1">
        你好，我是<br />
        <span class="brand-text">{profile.name}</span>
      </h1>

      {
        profile.positioning && (
          <p class="positioning" data-reveal style="--i:2">
            {profile.positioning}
          </p>
        )
      }

      {profile.summary[0] && <p class="tagline" data-reveal style="--i:3">{profile.summary[0]}</p>}

      <div class="cta" data-reveal style="--i:4">
        <a class="btn btn-primary" href="#projects">
          看看项目
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="arrow">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a class="btn btn-ghost" href="#contact">联系我</a>
      </div>

      <dl class="stats" data-reveal style="--i:5">
        {
          stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="visual" data-reveal style="--i:2">
      <div class="ring" aria-hidden="true"></div>
      <div class="portrait">
        {
          profile.avatar ? (
            <img src={profile.avatar} alt={profile.name} width="360" height="360" loading="eager" decoding="async" />
          ) : (
            <span class="initials" aria-hidden="true">
              {profile.initials}
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(4rem, 9vw, 8rem);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .place {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    font-weight: 560;
    color: var(--text-muted);
    margin-block-end: 1.4rem;
  }

  .place svg {
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--accent-2);
  }

  .hero h1 {
    margin-block-end: 1.1rem;
  }

  .positioning {
    font-size: clamp(1.1rem, 2.4vw, 1.45rem);
    font-weight: 680;
    letter-spacing: -0.015em;
    margin-block-end: 0.9rem;
  }

  .tagline {
    max-width: 34rem;
    font-size: 1.02rem;
    color: var(--text-muted);
    margin-block-end: 2rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-end: 2.75rem;
  }

  .arrow {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    transition: transform 0.3s var(--ease);
  }

  .cta a:hover .arrow {
    transform: translateX(3px);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
  }

  .stats div {
    /* dt 必须写在 dd 前面才符合 dl 语义，这里用反向排列让数字在上 */
    display: flex;
    flex-direction: column-reverse;
    gap: 0.1rem;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 780;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .stats dt {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  /* 头像 + 缓慢旋转的 conic 渐变光环 */
  .visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-inline-size: 24rem;
    justify-self: center;
    inline-size: 100%;
  }

  .ring {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--accent-1),
      var(--accent-2),
      var(--accent-3),
      var(--accent-4),
      var(--accent-1)
    );
    filter: blur(0.5px);
    opacity: 0.85;
    -webkit-mask: radial-gradient(closest-side, transparent 82%, #000 83%);
    mask: radial-gradient(closest-side, transparent 82%, #000 83%);
    animation: spin 18s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 76%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface-solid);
    box-shadow: var(--shadow-card);
  }

  .portrait img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .initials {
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    background: var(--brand);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  @media (width <= 52rem) {
    .grid {
      grid-template-columns: 1fr;
    }

    .visual {
      order: -1;
      max-inline-size: 15rem;
    }

    .cta {
      margin-block-end: 2rem;
    }
  }
</style>
