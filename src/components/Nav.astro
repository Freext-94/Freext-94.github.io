---
import SocialIcon from '@/components/SocialIcon.astro';
import type { ProfileInfo } from '@/lib/types';

interface Props {
  profile: ProfileInfo;
}

const { profile } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const links = [
  { href: `${home}#about`, label: '关于我' },
  { href: `${home}#skills`, label: '我会什么' },
  { href: `${home}#projects`, label: '我做过什么' },
  { href: `${home}#experience`, label: '工作历程' },
  { href: `${home}#contact`, label: '找到我' },
];
---

<header class="nav">
  <div class="shell inner">
    <a class="logo" href={`${home}#top`} aria-label={`${profile.name} 首页`}>
      <span class="mark" aria-hidden="true">{profile.initials}</span>
      <span class="who">{profile.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="页面导航">
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="menu-toggle"
      aria-label="打开导航菜单"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <div class="actions">
      <button
        type="button"
        class="toggle"
        data-theme-toggle
        aria-label="切换到暗色主题"
      >
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M19.1 4.9l-1.5 1.5M6.4 17.6l-1.5 1.5" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
        </svg>
      </button>

      {
        profile.email && (
          <a
            class="toggle mail"
            href={`mailto:${profile.email}`}
            aria-label={`发送邮件到 ${profile.email}`}
            title={profile.email}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2.5" />
              <path d="M3.5 7l8.5 6 8.5-6" />
            </svg>
          </a>
        )
      }

      {
        profile.github && (
          <a
            class="btn btn-primary resume"
            href={profile.github}
            rel="noopener noreferrer"
            target="_blank"
          >
            <SocialIcon icon="github" label="GitHub" />
            GitHub
          </a>
        )
      }
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  // href 是 "/#about" 这种绝对路径，直接 querySelector 会抛非法选择器，
  // 高亮比较也必须只看 hash，否则永远对不上。
  const hashOf = (el: HTMLAnchorElement) => new URL(el.href).hash;
  const sections = links
    .map((link) => document.querySelector(hashOf(link)))
    .filter((el): el is HTMLElement => el !== null);

  if (links.length && sections.length) {
    const setActive = (id: string) => {
      links.forEach((link) =>
        link.toggleAttribute('data-active', hashOf(link) === `#${id}`),
      );
    };

    // 只关心进入视口上沿那一段，滚动过程中高亮不会来回跳
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible?.target.id) setActive(visible.target.id);
      },
      { rootMargin: '-25% 0px -60% 0px' },
    );

    sections.forEach((section) => observer.observe(section));
  }

  // 移动端折叠菜单：点链接后立即收起，避免跳转后菜单还开着
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menuPanel = document.getElementById('mobile-nav');
  if (menuToggle && menuPanel) {
    menuToggle.addEventListener('click', () => {
      const open = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!open));
      menuPanel.hidden = open;
    });

    menuPanel.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menuToggle.setAttribute('aria-expanded', 'false');
        menuPanel.hidden = true;
      }),
    );
  }
</script>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    backdrop-filter: blur(16px) saturate(1.5);
    background: color-mix(in oklab, var(--bg) 72%, transparent);
    border-block-end: 1px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    block-size: 4.25rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 700;
    flex-shrink: 0;
  }

  .mark {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    border-radius: 0.7rem;
    background-image: var(--brand);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    box-shadow: 0 6px 18px -8px var(--glow);
    transition: transform 0.35s var(--ease);
  }

  .logo:hover .mark {
    transform: rotate(-8deg) scale(1.06);
  }

  .who {
    font-size: 1rem;
  }

  /* nav 是 flex 项，默认最小宽度等于内容宽度，窄屏会把右侧按钮顶出视口 */
  .inner > nav {
    flex: 1 1 auto;
    min-inline-size: 0;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: auto;
    /* 不加这行，flex 项的最小宽度等于内容宽度，窄屏会把右侧按钮顶出视口 */
    min-inline-size: 0;
  }

  .links::-webkit-scrollbar {
    display: none;
  }

  .links a {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 560;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s, background-color 0.25s;
  }

  .links a:hover {
    color: var(--text);
    background: var(--sunken);
  }

  .links a[data-active] {
    color: var(--accent-1);
    background: var(--brand-soft);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .toggle {
    display: grid;
    place-items: center;
    inline-size: 2.35rem;
    block-size: 2.35rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
    transition: border-color 0.25s, transform 0.25s var(--ease);
  }

  .toggle:hover {
    border-color: var(--accent-1);
    transform: translateY(-1px);
  }

  .toggle svg {
    grid-area: 1 / 1;
    inline-size: 1.15rem;
    block-size: 1.15rem;
    transition: opacity 0.3s var(--ease), transform 0.4s var(--ease);
  }

  .toggle .moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  [data-theme='dark'] .toggle .sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }

  [data-theme='dark'] .toggle .moon {
    opacity: 1;
    transform: none;
  }

  .resume {
    padding: 0.5rem 1rem;
    font-size: 0.86rem;
  }

  .resume svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  /* 邮箱沿用 .toggle 的圆形容器样式，只换个强调色 */
  .mail {
    color: var(--accent-2);
    text-decoration: none;
  }

  .mail:hover {
    border-color: var(--accent-2);
  }

  /* 窄屏收起文字链接，换成折叠菜单，避免导航把右侧按钮顶出屏幕 */
  .menu-toggle {
    display: none;
    place-items: center;
    gap: 4px;
    inline-size: 2.35rem;
    block-size: 2.35rem;
    margin-inline-start: auto;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    inline-size: 1rem;
    block-size: 1.5px;
    border-radius: 2px;
    background: var(--text);
  }

  .mobile-nav {
    display: none;
  }

  @media (width <= 46rem) {
    .who {
      display: none;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    .mobile-nav:not([hidden]) {
      display: block;
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      padding: 0.5rem clamp(1rem, 4vw, 1.5rem) 1rem;
      border-block-end: 1px solid var(--border);
      background: color-mix(in oklab, var(--bg) 94%, transparent);
      backdrop-filter: blur(16px);
    }

    .mobile-nav ul {
      display: grid;
      gap: 0.15rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .mobile-nav a {
      display: block;
      padding: 0.65rem 0.75rem;
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      font-size: 0.95rem;
      text-decoration: none;
    }

    .mobile-nav a:active {
      background: var(--sunken);
      color: var(--text);
    }
  }

  @media (width <= 34rem) {
    .resume {
      display: none;
    }
  }
</style>
