---
/**
 * 统一 24×24 描边图标 + 中文/字母字形兜底。
 * 不引入图标库：整套只需要这十几个，而且能保证描边粗细一致。
 */
interface Props {
  icon: string;
  label: string;
}

const { icon, label } = Astro.props;

const STROKE: Record<string, string> = {
  github: 'M9 19 3 12l6-7 M15 5l6 7-6 7',
  mail: 'M3 6h18v12H3z M3 7l9 6 9-6',
  blog: 'M4 20h4L20 8l-4-4L4 16z M14 6l4 4',
  telegram: 'M21 4 3 11l6 2 2 6z M9 13l8-7',
  bilibili: 'M4 9h16v10H4z M8 4l3 3 M16 4l-3 3 M9 13v2 M15 13v2',
  wechat: 'M4 6h11a3 3 0 0 1 3 3v3a3 3 0 0 1-3 3H8l-4 3z M17 13h3a2 2 0 0 1 2 2v3l3 2',
  link: 'M14 5h5v5 M19 5l-8 8 M12 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6',
  twitter: 'M4 4l16 16 M20 4L4 20',
};

const GLYPH: Record<string, string> = {
  zhihu: '知',
  juejin: '掘',
  linkedin: 'in',
};

const stroke = STROKE[icon];
const glyph = GLYPH[icon];
---

<span class="icon" aria-hidden="true">
  {
    stroke && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d={stroke} />
      </svg>
    )
  }
  {glyph && <span class="glyph">{glyph}</span>}
  <span class="sr-only">{label}</span>
</span>

<style>
  .icon {
    display: grid;
    place-items: center;
    inline-size: 1.15rem;
    block-size: 1.15rem;
  }

  .icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .glyph {
    font-size: 0.9em;
    font-weight: 700;
    line-height: 1;
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
